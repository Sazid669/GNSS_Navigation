<launch>
  <rosparam file="$(find scout_mini_project)/config/amcl_params.yaml" />

  <!-- Start AMCL node -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_map_topic" value="true" />
    <param name="scan_topic" value="/scan" />
    <param name="base_frame_id" value="base_link" />
    <param name="odom_frame_id" value="odom" />
    <param name="global_frame_id" value="map" />
  </node>

  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan" output="screen">
    <param name="cloud_topic" value="/velodyne_points"/>
    <param name="scan_topic" value="/scan" />
    <param name="frame_id" value="base_link" />
    <param name="max_range" value="100.0" />
    <param name="angle_min" value="-1.5708" />
    <param name="angle_max" value="1.5708" />
    <param name="angle_increment" value="0.0043633" />
    <param name="scan_time" value="0.1" />
    <param name="min_range" value="0.1" />
  </node>

  <node pkg="map_server" type="map_server" name="map_server" args="$(find scout_mini_project)/maps/map.yaml" />
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find scout_mini_project)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find scout_mini_project)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find scout_mini_project)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find scout_mini_project)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find scout_mini_project)/config/base_local_planner_params.yaml" command="load" />
    <rosparam file="$(find scout_mini_project)/config/move_base_params.yaml" command="load" />
  </node>

  <node pkg="scout_mini_project" type="nav_gps_robot.py" name="gps_nav" output="screen" />
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find scout_mini_project)/rviz/mini_rviz.rviz" output="screen" />
</launch>
