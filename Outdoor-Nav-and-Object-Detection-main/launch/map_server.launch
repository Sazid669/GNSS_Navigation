<launch>
    <!-- <param name="~frame_id" type="string" value="odom" /> -->
    <include file="$(find scout_mini_project)/launch/scout_mini_playpen.launch" />
    <node pkg="scout_mini_project" type="laser_scan_to_point_cloud_node.py" name="laserscan_to_pointcloud"/>   
    <!-- <node pkg="scout_mini_project" type="camera_nav_test.py" name="camera_nav"/>   -->

    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
        <param name="resolution" value="0.05" />
        <remap from="projected_map" to="map" />
        <param name="frame_id" type="string" value="map" />
        <param name="sensor_model/max_range" value="6" /> 
        <param name="occupancy_min_z" value="0.05" />
        <remap from="cloud_in" to="velodyne_points" />
    </node>
  <!--  -->
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
        <remap from="scan" to="/scan"/>  or ! To be chacked!<remap from="scan" to="/base_scan"/>
        <param name="base_frame" value="base_link"/> 
        <param name="odom_frame" value="odom"/> 
        <param name="map_frame" value="map"/> 
    </node>
    
     <!-- Robot Localization EKF Node -->
    <!-- <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization_node" output="screen">
        <param name="use_sim_time" value="true" /> 
        <param name="config_file" value="$(find scout_mini_project)/config/EKKF.yaml" />
    </node> -->


    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find scout_mini_project)/rviz/mini_rviz.rviz" output="screen" />


</launch>

